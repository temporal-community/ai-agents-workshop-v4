#!/bin/bash
# ABOUTME: Drives challenge 3 to one completed triage Workflow, non-interactively.
# Runs the SOLUTION tree, never the attendee's exercise/.
#
# The client creates the c3-travel-planner Nexus endpoint itself on first run,
# so there is nothing to register here.
set -euxo pipefail

cd /root/workshop/decouple-agents/solution

pkill -f "challenge3-multi-agent/worker.ts" 2>/dev/null || true
sleep 1

nohup npm run c3:worker > /tmp/solve-c3-worker.log 2>&1 &
sleep 20

timeout 180 npm run c3:client -- "What's the weather in Monaco, and what should I know about visiting?"

pkill -f "challenge3-multi-agent/worker.ts" 2>/dev/null || true
