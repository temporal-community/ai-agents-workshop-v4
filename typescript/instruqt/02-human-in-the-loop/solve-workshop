#!/bin/bash
# ABOUTME: Drives challenge 2 through a full propose-approve-resume cycle,
# non-interactively. Runs the SOLUTION tree, never the attendee's exercise/.
#
# `yes y` answers the client's `Approve the booking? [y/N]` prompt, which it
# reads from stdin one line at a time.
set -euxo pipefail

cd /root/workshop/decouple-agents/solution

pkill -f "challenge2-human-in-the-loop/worker.ts" 2>/dev/null || true
sleep 1

nohup npm run c2:worker > /tmp/solve-c2-worker.log 2>&1 &
sleep 15

yes y | timeout 180 npm run c2:client -- "Book me a trip to Barcelona on 2026-09-15."

pkill -f "challenge2-human-in-the-loop/worker.ts" 2>/dev/null || true
