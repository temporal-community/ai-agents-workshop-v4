#!/bin/bash
# ABOUTME: Track-level setup. Runs once, when the attendee enters the track.
# Everything slow is baked into the sandbox image (Node deps, Python venvs,
# Temporal CLI, code-server). This script only starts services and mints the
# attendee's own LLM credentials.
#
#   1. Start the Temporal dev server and code-server
#   2. Wait for Temporal to report healthy
#   3. Mint a learner-scoped LiteLLM key and expose it as OpenAI-compatible env
#      to every terminal tab
#
# Deliberately NOT done here: registering Nexus endpoints. Challenge 3's client
# creates its own endpoint, and creating challenge 4's endpoint is TODO 15 -
# the whole point of that challenge. Pre-creating either would quietly complete
# the exercise for the attendee.

set -euo pipefail

# ── LiteLLM secret broker ─────────────────────────────────────────────────────
SECRET_BROKER_BASE_URL="${SECRET_BROKER_BASE_URL:-https://tmprl-dem-cld-secret-broker-429214323166-us-west-1.s3.us-west-1.amazonaws.com/secret-broker}"
SECRET_BROKER_VERSION="${SECRET_BROKER_VERSION:-main}"
LITELLM_KEY_DURATION="${LITELLM_KEY_DURATION:-1d}"
LITELLM_MAX_BUDGET="${LITELLM_MAX_BUDGET:-5}"
LITELLM_ENV_FILE="/root/.litellm-env"

export INSTRUQT_BROKER_URL="${INSTRUQT_BROKER_URL:-https://litellm-broker-instruqt.tmprl-demo.cloud}"
export INSTRUQT_BROKER_KEY_ID="${INSTRUQT_BROKER_KEY_ID:-v1}"

# The broker mints against this track id. It defaults to this track's own slug,
# `temporal-ai-agents-typescript`.
#
# HEADS UP: that slug is new. The current secret-broker CLI mints against the
# track's own slug without any pre-registration, but older broker deployments
# kept an allowlist. If this slug is not accepted you will see the failure only
# at RUNTIME, as "Failed to start track" - because the mint runs under `set -e`
# and aborts the whole lab start. The broker's own error (HTTP 404 = track id
# not on the allowlist, HTTP 422 = request rejected) is visible by running
# `instruqt track test` from the `instruqt/` directory, which prints the setup
# log on failure.
#
# If that happens, get `temporal-ai-agents-typescript` registered with the
# broker. Do NOT borrow another track's id as a workaround: per-track key
# quotas are real and the borrowed id starts returning 422 once exhausted.
export INSTRUQT_LITELLM_TRACK_ID="${INSTRUQT_LITELLM_TRACK_ID:-${INSTRUQT_TRACK_SLUG:-temporal-ai-agents-typescript}}"

# Model every challenge asks the gateway for. The TypeScript clients read
# OPENAI_MODEL and pass the name into the Workflow as data (Workflow code runs
# in a deterministic sandbox and cannot read the environment).
export OPENAI_MODEL="${OPENAI_MODEL:-gpt-4o}"

WORKSHOP_DIR=/root/workshop/decouple-agents

mint_litellm_token() {
    if [ -z "${TEMPORAL_LITELLM_BROKER_SECRET:-}" ]; then
        echo "ERROR: TEMPORAL_LITELLM_BROKER_SECRET is not set. Configure the Instruqt secret before starting the track." >&2
        exit 1
    fi

    local installer="/tmp/install-secret-broker.sh"

    curl --fail --silent --show-error --location \
        --retry 10 \
        --retry-all-errors \
        --retry-delay 2 \
        --retry-max-time 60 \
        --connect-timeout 10 \
        "${SECRET_BROKER_BASE_URL}/${SECRET_BROKER_VERSION}/install.sh" \
        --output "${installer}"

    SECRET_BROKER_BASE_URL="${SECRET_BROKER_BASE_URL}" \
    SECRET_BROKER_VERSION="${SECRET_BROKER_VERSION}" \
        sh "${installer}"

    export TEMPORAL_LITELLM_BROKER_SECRET
    secret-broker litellm \
        --duration="${LITELLM_KEY_DURATION}" \
        --budget="${LITELLM_MAX_BUDGET}"

    # The broker writes OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL as shell
    # exports into LITELLM_ENV_FILE. Make them available to this script too.
    # shellcheck disable=SC1090
    . "${LITELLM_ENV_FILE}"
}

# 1. Background services.
nohup temporal server start-dev \
    --ip 0.0.0.0 \
    --db-filename /root/temporal.db \
    --log-level warn \
    > /tmp/temporal-server.log 2>&1 &

# code-server binds 8080. NOT 8443: the Instruqt tab proxy cannot reach it
# there, and the tab hangs on "Please wait" with no error anywhere.
#
# --auth none because the tab has no way to type a password.
#
# --user-data-dir is stated explicitly and matches the directory the image
# seeds settings.json into. Two settings in there are load-bearing:
#   security.workspace.trust.enabled: false  - otherwise the workbench renders
#       a blank page inside the iframe instead of the trust prompt
#   files.autoSave: afterDelay               - the assignments tell attendees
#       the editor saves as they type; if that were false they would run stale
#       code and blame their own edits
#
# It opens the whole decouple-agents directory, so exercise/ and solution/ are
# both in one tree under ONE editor tab. A second editor tab would be booted
# hidden at challenge start, and code-server cannot lay itself out in a 0x0
# iframe - it needs a manual refresh to become usable.
nohup code-server \
    --host 0.0.0.0 \
    --port 8080 \
    --auth none \
    --user-data-dir /root/.local/share/code-server \
    "${WORKSHOP_DIR}" \
    > /tmp/code-server.log 2>&1 &

# 2. Wait for Temporal health.
for _ in $(seq 1 60); do
    if temporal operator cluster health --address 127.0.0.1:7233 >/dev/null 2>&1; then
        echo "Temporal server healthy."
        break
    fi
    sleep 1
done

# 3. Mint the attendee's LiteLLM key.
mint_litellm_token

# 4. Make the minted credentials reach every terminal tab.
#
# Each tab is a fresh login shell, so exporting above is not enough. Source the
# env file from /etc/bash.bashrc, guarded so re-running this script cannot
# append it twice.
if ! grep -q 'litellm-env' /etc/bash.bashrc 2>/dev/null; then
    {
        echo ''
        echo '# Per-attendee LiteLLM credentials, minted at lab start.'
        echo '[ -f /root/.litellm-env ] && . /root/.litellm-env'
    } >> /etc/bash.bashrc
fi

echo "Track setup complete. Workshop at ${WORKSHOP_DIR}"
