#!/bin/bash
# ABOUTME: Challenge 0 setup. This is the first challenge, so there is nothing
# left over from a previous one - but a learner who reloads the track, or an
# `instruqt track test` run that replays challenges out of order, can still
# arrive here with a Worker from a later challenge holding a Task Queue.
# Clearing them costs nothing and removes a whole class of "why is my output
# interleaved" confusion.
#
# One pkill per pattern, always. `pkill -f "a|b"` is a GNU-ism: it matches the
# literal string "a|b" on macOS, silently killing nothing, so an alternation
# that "works in CI" quietly stops working on a laptop.
set -euo pipefail

pkill -f "challenge0-the-loop/agent-loop.ts" 2>/dev/null || true
pkill -f "challenge1-durable-agent/worker.ts" 2>/dev/null || true
pkill -f "challenge2-human-in-the-loop/worker.ts" 2>/dev/null || true
pkill -f "challenge3-multi-agent/worker.ts" 2>/dev/null || true
pkill -f "challenge4-heterogeneous-agents/worker.ts" 2>/dev/null || true
pkill -f "python-travel-planner" 2>/dev/null || true

echo "Challenge 0 ready."
