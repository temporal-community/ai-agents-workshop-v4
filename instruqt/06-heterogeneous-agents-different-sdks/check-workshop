#!/bin/bash
set -euo pipefail
# Demo 5 also completes workflows on orchestrator-tq, so only count workflows
# started after this challenge began (marker written by setup-workshop).
SINCE=$(cat /tmp/demo6a-start 2>/dev/null || echo "1970-01-01T00:00:00Z")
COMPLETED=$(temporal workflow list \
    --address 127.0.0.1:7233 \
    --namespace default \
    --query "TaskQueue='orchestrator-tq' AND ExecutionStatus='Completed' AND StartTime > '${SINCE}'" \
    --limit 5 2>/dev/null | grep -c "Completed" || true)
if [[ "${COMPLETED}" -lt 1 ]]; then
    echo "FAIL: No completed orchestrator workflows. Run a prompt that invokes the travel planner."
    exit 1
fi
echo "OK: At least one demo6a orchestrator workflow completed."
exit 0
