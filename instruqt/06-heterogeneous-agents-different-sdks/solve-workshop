#!/bin/bash
# Drives demo6a's solution to one completed orchestrator workflow, non-interactively.
# Same two workers as demo5, but the personal assistant also carries a third
# specialist (the Strands travel planner) as a plain activity.
set -uo pipefail
cd /root/workshop/demo6a-different-sdks/solution || exit 0

pkill -f "python -m worker_pa\|python -m worker_f1" 2>/dev/null || true
sleep 1

nohup uv run python -m worker_pa > /tmp/solve-06a-worker-pa.log 2>&1 &
PA_PID=$!
nohup uv run python -m worker_f1 > /tmp/solve-06a-worker-f1.log 2>&1 &
F1_PID=$!
sleep 12

timeout 90 uv run python -m start_workflow "Tell me about Monaco as a travel destination."

kill "$PA_PID" "$F1_PID" 2>/dev/null || true
exit 0
