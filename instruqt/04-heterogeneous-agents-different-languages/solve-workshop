#!/bin/bash
# Drives demo6b's solution to one completed TravelPlannerAgentWorkflow, non-interactively.
# Three workers: worker_pa (orchestrator + weather), worker_f1 (F1 expert over
# Nexus), and the Java Spring AI travel planner (over the pre-registered
# "travel-planner" Nexus endpoint).
set -uo pipefail
cd /root/workshop/demo6b-different-languages/solution || exit 0

pkill -f "python -m worker_pa\|python -m worker_f1\|spring-boot:run" 2>/dev/null || true
sleep 1

nohup uv run python -m worker_pa > /tmp/solve-06b-worker-pa.log 2>&1 &
PA_PID=$!
nohup uv run python -m worker_f1 > /tmp/solve-06b-worker-f1.log 2>&1 &
F1_PID=$!

(cd travel-planner-java && nohup ./mvnw -q spring-boot:run > /tmp/solve-06b-travel-planner-java.log 2>&1 &)
sleep 45

timeout 120 uv run python -m start_workflow "What should I know about visiting Monaco?"

kill "$PA_PID" "$F1_PID" 2>/dev/null || true
pkill -f "spring-boot:run" 2>/dev/null || true
exit 0
