#!/bin/bash
# Drives the intro solution to one completed workflow, non-interactively.
set -uo pipefail
cd /root/workshop/demo2-openai-temporal-integration/solution || exit 0

pkill -f "python -m worker" 2>/dev/null || true
sleep 1

nohup uv run python -m worker > /tmp/solve-02-worker.log 2>&1 &
WORKER_PID=$!
sleep 10

timeout 90 uv run python -m start_workflow "What is the weather in Barcelona?"

kill "$WORKER_PID" 2>/dev/null || true
exit 0
