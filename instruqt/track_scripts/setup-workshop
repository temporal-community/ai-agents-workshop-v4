#!/bin/bash
# ABOUTME: Track-level setup. Runs once when the attendee enters the track.
# Everything heavy is baked into the image. This script only:
#   1. Stages /opt/workshop -> /root/workshop (attendee's writable copy)
#   2. Copies proxy state to a writable location
#   3. Patches the runtime proxy config for LiteLLM
#   4. Starts background services
#   5. Waits for Temporal health
#   6. Registers Nexus endpoints
#   7. Mints a learner-scoped LiteLLM key and writes OpenAI-compatible env
set -euo pipefail

BROKER_URL="${INSTRUQT_BROKER_URL:-https://litellm-broker-instruqt.tmprl-demo.cloud}"
BROKER_KEY_ID="${INSTRUQT_BROKER_KEY_ID:-v1}"
# INTERIM: borrow v3's broker registration until temporal-ai-agents-python-v4
# is added to the LiteLLM broker allowlist. Once v4 is registered, drop this
# override so the track scopes its own LLM usage:
#   LITELLM_TRACK_ID="${INSTRUQT_LITELLM_TRACK_ID:-${INSTRUQT_TRACK_SLUG:-...}}"
LITELLM_TRACK_ID="${INSTRUQT_LITELLM_TRACK_ID:-temporal-python-ai-agents-v3}"
OPENAI_MODEL="${OPENAI_MODEL:-gpt-4o}"
LITELLM_ENV_FILE="/root/.litellm-env"
LITELLM_PROXY_HOST="${LITELLM_PROXY_HOST:-litellm-instruqt.tmprl-demo.cloud}"

patch_runtime_proxy_config() {
    TOGGLE_ADDON="/root/proxy/toggle_addon.py" \
    CONTROLPANEL="/root/proxy/controlpanel.py" \
    LITELLM_PROXY_HOST="${LITELLM_PROXY_HOST}" \
    python3 - <<'PY'
import os
import re
from pathlib import Path

litellm_host = os.environ["LITELLM_PROXY_HOST"]
toggle_addon = Path(os.environ["TOGGLE_ADDON"])
controlpanel = Path(os.environ["CONTROLPANEL"])

source = toggle_addon.read_text()
line_pattern = re.compile(r'(?m)^(\s*"openai"\s*:\s*)\[[^\]]*\](\s*,\s*)$')
replacement = rf'\1["api.openai.com", "{litellm_host}"]\2'
updated, replacements = line_pattern.subn(replacement, source, count=1)
if replacements != 1:
    raise SystemExit(f"Could not patch OpenAI proxy host list in {toggle_addon}")
toggle_addon.write_text(updated)

source = controlpanel.read_text()
updated = source.replace(
    '"openai":      "OpenAI  (api.openai.com)"',
    '"openai":      "OpenAI  (LiteLLM gateway)"',
)
controlpanel.write_text(updated)
PY
}

mint_litellm_token() {
    if [ -z "${TEMPORAL_LITELLM_BROKER_SECRET:-}" ]; then
        echo "ERROR: TEMPORAL_LITELLM_BROKER_SECRET is not set. Configure the Instruqt secret before starting the track." >&2
        exit 1
    fi

    local participant_id
    local participant_email
    local body
    local timestamp
    local nonce
    local signature
    local response

    participant_id="${INSTRUQT_PARTICIPANT_ID:-${INSTRUQT_SANDBOX_ID:-$(hostname)}}"
    participant_email="${INSTRUQT_USER_EMAIL:-${INSTRUQT_PARTICIPANT_EMAIL:-}}"

    body="$(
        LITELLM_TRACK_ID="${LITELLM_TRACK_ID}" \
        PARTICIPANT_ID="${participant_id}" \
        PARTICIPANT_EMAIL="${participant_email}" \
        python3 - <<'PY'
import json
import os

def optional(name):
    return os.environ.get(name) or None

print(json.dumps({
    "track_id": os.environ["LITELLM_TRACK_ID"],
    "participant_id": os.environ["PARTICIPANT_ID"],
    "participant_email": optional("PARTICIPANT_EMAIL"),
    "track_slug": optional("INSTRUQT_TRACK_SLUG"),
    "metadata": {
        "sandbox_id": optional("INSTRUQT_SANDBOX_ID"),
        "instruqt_track_id": optional("INSTRUQT_TRACK_ID"),
        "track_slug": optional("INSTRUQT_TRACK_SLUG"),
        "user_id": optional("INSTRUQT_USER_ID"),
    },
}, separators=(",", ":")))
PY
    )"
    timestamp="$(date +%s)"
    nonce="$(python3 - <<'PY'
import secrets
print(secrets.token_hex(16))
PY
)"
    signature="$(
        BODY="${body}" \
        TIMESTAMP="${timestamp}" \
        NONCE="${nonce}" \
        HMAC_SECRET="${TEMPORAL_LITELLM_BROKER_SECRET}" \
        python3 - <<'PY'
import hashlib
import hmac
import os

message = f"{os.environ['TIMESTAMP']}.{os.environ['NONCE']}.".encode() + os.environ["BODY"].encode()
digest = hmac.new(os.environ["HMAC_SECRET"].encode(), message, hashlib.sha256).hexdigest()
print(f"sha256={digest}")
PY
    )"

    response="$(
        curl -fsS "${BROKER_URL}/v1/token" \
            -H "Content-Type: application/json" \
            -H "X-Instruqt-Key-Id: ${BROKER_KEY_ID}" \
            -H "X-Instruqt-Timestamp: ${timestamp}" \
            -H "X-Instruqt-Nonce: ${nonce}" \
            -H "X-Instruqt-Signature: ${signature}" \
            --data "${body}"
    )"

    RESPONSE="${response}" \
    LITELLM_ENV_FILE="${LITELLM_ENV_FILE}" \
    OPENAI_MODEL="${OPENAI_MODEL}" \
    python3 - <<'PY'
import json
import os
import shlex
from pathlib import Path

response = json.loads(os.environ["RESPONSE"])
base_url = response["litellm_base_url"].rstrip("/")
api_key = response["api_key"]
model = os.environ["OPENAI_MODEL"].strip() or response.get("default_model", "gpt-4o").split("/", 1)[-1]

values = {
    "LITELLM_BASE_URL": base_url,
    "OPENAI_BASE_URL": base_url,
    "OPENAI_API_KEY": api_key,
    "OPENAI_MODEL": model,
    "OPENAI_AGENTS_DISABLE_TRACING": "1",
    "SPRING_AI_OPENAI_BASE_URL": base_url,
    "SPRING_AI_OPENAI_CHAT_BASE_URL": base_url,
}

env_file = Path(os.environ["LITELLM_ENV_FILE"])
env_file.write_text("".join(
    f"export {name}={shlex.quote(value)}\n"
    for name, value in values.items()
))
env_file.chmod(0o600)

etc_environment = Path("/etc/environment")
existing = []
if etc_environment.exists():
    prefixes = tuple(f"{name}=" for name in values)
    existing = [
        line for line in etc_environment.read_text().splitlines()
        if not line.startswith(prefixes)
    ]
existing.extend(f"{name}={value}" for name, value in values.items())
etc_environment.write_text("\n".join(existing) + "\n")
PY

    if ! grep -q "${LITELLM_ENV_FILE}" /root/.bashrc 2>/dev/null; then
        cat >> /root/.bashrc <<EOF

if [ -f ${LITELLM_ENV_FILE} ]; then
    . ${LITELLM_ENV_FILE}
fi
EOF
    fi

    # Make the minted key available to the remainder of this lifecycle script too.
    # shellcheck disable=SC1090
    . "${LITELLM_ENV_FILE}"
    echo "LiteLLM learner key minted for track ${LITELLM_TRACK_ID}."
}

# 1. Stage workshop source into writable home directory.
if [ ! -d /root/workshop ]; then
    cp -r /opt/workshop /root/workshop
fi

# 2. Stage proxy state into writable location.
mkdir -p /root/proxy/static
cp -r /opt/proxy/* /root/proxy/

# 3. Patch the writable proxy config before mitmproxy loads it.
patch_runtime_proxy_config

# 4. Start background services.
nohup mitmdump \
    --listen-port 8888 \
    --set block_global=false \
    --set ssl_insecure=false \
    -s /root/proxy/toggle_addon.py \
    > /tmp/proxy.log 2>&1 &

nohup /opt/mitmproxy-venv/bin/python /root/proxy/controlpanel.py \
    > /tmp/controlpanel.log 2>&1 &

nohup temporal server start-dev \
    --ip 0.0.0.0 \
    --db-filename /root/temporal.db \
    --log-level warn \
    > /tmp/temporal-server.log 2>&1 &

# code-server points at the attendee's writable workshop copy.
nohup code-server \
    --host 0.0.0.0 \
    --port 8080 \
    --auth none \
    /root/workshop \
    > /tmp/code-server.log 2>&1 &

# 5. Wait for Temporal health.
for i in $(seq 1 60); do
    if temporal operator cluster health --address 127.0.0.1:7233 >/dev/null 2>&1; then
        echo "Temporal server healthy."
        break
    fi
    sleep 1
done

# 6. Register Nexus endpoints (idempotent).
temporal operator nexus endpoint create \
    --name f1-expert \
    --target-namespace default \
    --target-task-queue f1-expert-agent-tq \
    --address 127.0.0.1:7233 || true

temporal operator nexus endpoint create \
    --name f1-expert-d6 \
    --target-namespace default \
    --target-task-queue f1-expert-agent-tq \
    --address 127.0.0.1:7233 || true

temporal operator nexus endpoint create \
    --name travel-planner \
    --target-namespace default \
    --target-task-queue travel-planner-agent-tq \
    --address 127.0.0.1:7233 || true

# 7. Mint a learner-scoped LiteLLM key and expose it as OpenAI-compatible env.
mint_litellm_token

# 8. Background FastF1 cache warm for current season.
# Runs asynchronously so it doesn't block track startup.
# Fetches the last 3 completed 2026 races so F1 queries don't cold-fetch
# during the workshop. Non-fatal if it fails.
nohup "${F1_MCP_HOME}/.venv/bin/python" - <<'PYWARM' > /tmp/f1-cache-warm.log 2>&1 &
import fastf1, os, datetime
cache_dir = '/opt/f1-mcp-server/cache'
os.makedirs(cache_dir, exist_ok=True)
fastf1.Cache.enable_cache(cache_dir)

current_year = datetime.datetime.now().year
try:
    schedule = fastf1.get_event_schedule(current_year, include_testing=False)
    completed = schedule[schedule['EventDate'] < datetime.datetime.now()]
    recent = completed.tail(3)
    for _, row in recent.iterrows():
        try:
            s = fastf1.get_session(current_year, row['EventName'], 'R')
            s.load(telemetry=False, weather=False, messages=False)
            print(f"Warmed {current_year} {row['EventName']} Race")
        except Exception as e:
            print(f"Skipped {row['EventName']}: {e}")
except Exception as e:
    print(f"Schedule fetch failed: {e}")
PYWARM
echo "FastF1 background cache warm started (see /tmp/f1-cache-warm.log)"
