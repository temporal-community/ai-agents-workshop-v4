{
  "name": "Build AI Agents That Survive Failure",

  // Contains all seven demos with their uv venvs, JDK 21 + offline Maven deps,
  // the F1 MCP server and a warm FastF1 cache, so there is nothing to install at
  // Codespace start. Codespaces-only; the Instruqt track pins its own image in
  // instruqt/config.yml, independently.
  //
  // Public GHCR, pinned to an immutable tag. Byte-identical to the image the
  // tmprl-dem-cld pipeline built from commit 038a1e9: copied from
  // public.ecr.aws/.../workshop:git-038a1e92...-b627af6b6e95e, digest verified
  // sha256:81ce22fcec6fac41c77b1507f16482f835f0e21cee3018a08a1625be55a6a6c5.
  //
  // Two registries were tried first and are the wrong answer:
  //
  //   public.ecr.aws  rate-limits anonymous pulls. Codespaces pulls
  //                   anonymously, so creation failed with "toomanyrequests:
  //                   Rate exceeded" and Codespaces then SILENTLY fell back to
  //                   a recovery container (devcontainers/base:alpine)
  //                   containing none of the workshop. It looks like a healthy
  //                   Codespace with everything missing.
  //   Docker Hub      100 anonymous pulls per 6h per IP. Survivable for one
  //                   person, not for a room sharing Codespaces egress IPs.
  //
  // GHCR does not apply those anonymous limits. The package lives in a personal
  // namespace because temporal-community org policy disables both Public and
  // Internal package visibility, and the org package's Codespaces
  // repository-access picker would not list this repo.
  //
  // Verified public and anonymously pullable 2026-08-01: manifest list resolves
  // to a linux/amd64 child, 29 layers, 1.46 GB compressed, no credentials.
  //
  // Codespaces-only. The Instruqt track pins its own image in
  // instruqt/config.yml, independently.
  "image": "ghcr.io/nadvolod/ai-agents-workshop-v4-sandbox:git-038a1e9",

  // The image is ~3.4 GB and the demos want the headroom Instruqt gave them
  // (memory: 6144).
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  // postStart only, and start.sh is idempotent. Running it from onCreate as well
  // would double-start every background service.
  "postStartCommand": "bash .devcontainer/start.sh",

  // Opens the runbook on attach. Non-fatal if it fails.
  "postAttachCommand": "code .devcontainer/RUNBOOK.md || true",

  // OPENAI_API_KEY is supplied as a Codespaces secret, which arrives as a real
  // environment variable in the container. Do NOT map it through remoteEnv with
  // ${localEnv:...} -- that reads the host environment, not the secret store.
  //   https://github.com/settings/codespaces

  "forwardPorts": [5000, 7233, 8233, 8090, 8091, 8092, 8093],
  "portsAttributes": {
    "5000": { "label": "Network Control Panel", "onAutoForward": "notify" },
    "7233": { "label": "Temporal gRPC", "onAutoForward": "silent" },
    "8233": { "label": "Temporal UI", "onAutoForward": "notify" },
    "8090": { "label": "Architecture demo 5", "onAutoForward": "silent" },
    "8091": { "label": "Architecture demo 6b", "onAutoForward": "silent" },
    "8092": { "label": "Architecture demo 4", "onAutoForward": "silent" },
    "8093": { "label": "Architecture demo 6a", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      // Deliberately minimal. Every extension is installed on first start, so
      // this list is most of what stands between an attendee and a prompt.
      "extensions": ["ms-python.python"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
